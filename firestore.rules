rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── FUNCIONES DE UTILIDAD ─────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─── COLECCIÓN: users ──────────────────────────────────────────────────
    // FastAPI lee perfiles con Admin SDK (las reglas no aplican al Admin SDK).
    // Esta regla protege escrituras directas desde el cliente (ej. fcm_token).
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // ─── COLECCIÓN: stop_requests ──────────────────────────────────────────
    // Toda escritura (create/update/delete) pasa por FastAPI con Admin SDK.
    // El Admin SDK bypasea estas reglas, por lo que bloquear escritura directa
    // del cliente NO afecta a la API. Impide que un cliente evada la máquina
    // de estados (pending→accepted→completed) y la validación de rol.
    // Ref: SDD_FASE3_UBISAFE.md §7.2.4
    match /stop_requests/{requestId} {
      allow read: if isAuthenticated()
                  && (resource.data.buyer_uid == request.auth.uid
                      || resource.data.vendor_uid == request.auth.uid);
      allow write: if false;
    }

    // ─── COLECCIÓN: risk_zones ─────────────────────────────────────────────
    // Toda escritura (create/update/delete) pasa por FastAPI con Admin SDK.
    // Impide que un cliente cree zonas con severity arbitraria, modifique la
    // geolocalización o marque activo=false directamente.
    // Ref: SDD_FASE3_UBISAFE.md §7.2.4
    match /risk_zones/{zoneId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─── iter.2: rides, community_reports ─────────────────────────────────
    // Se añaden en F6 y F7 respectivamente.

  }
}
