# Environment variables — do NOT commit this file
# Copy to .env and fill in your values

# Firebase service account JSON (stringified as a single-line JSON string)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google Maps API key
GOOGLE_MAPS_API_KEY=

# Firebase project ID (production: ubisafe-ca262 | local emulators: demo-ubisafe)
FIREBASE_PROJECT_ID=ubisafe-ca262

# CORS allowed origins, comma-separated. Use * for mobile-only APIs.
ALLOWED_ORIGINS=*
